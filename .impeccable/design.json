  "narrative": {
    "northStar": "Modern cinematic film suite",
    "overview": "Obsidian ground, deep slate layers and warm amber actions restore the approved film-suite direction from `outputs/Promo-Studio-GitHub/static`. This record follows the active `static/styles.css`, `static/index.html` and `static/app.js`. The restored source is the visual authority; no new exploration, seed or comp is claimed.\n\nThe interface combines softly rounded elevated panels, restrained glass treatments and ambient action glows with precise source references. Full-show discovery gives this same material vocabulary a spacious editorial opening and ruled posting-order results. The PDF remains a light paper handoff with dark ink and warm accent rules.",
    "keyCharacteristics": [
      "Obsidian ground and layered slate surfaces",
      "Warm amber actions and focus",
      "Sans-serif reading with monospaced technical references",
      "Ambient depth, translucent surfaces and rounded panels",
      "Source-led ranked results and inspectable coverage"
    ],
    "rules": [
      {
        "name": "The Action Signal Rule",
        "body": "Use amber for primary actions, selected states and keyboard focus; keep cyan and semantic colors tied to their technical or status meanings.",
        "section": "colors"
      },
      {
        "name": "The Source Reference Rule",
        "body": "Separate exact source text from technical ranges and editorial reasons; preserve line breaks and keep source references easy to scan.",
        "section": "typography"
      },
      {
        "name": "The Material Continuity Rule",
        "body": "Keep slate layers, soft depth and warm action glows coherent across manual and discovery surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the restored slate and amber tokens across manual and discovery modes.",
      "**Do** preserve distinct source text, technical timecodes and editorial reasons.",
      "**Do** keep focus, completion, failure and incomplete coverage states explicit.",
      "**Do** retain the form-first mobile discovery order and accessible disclosures."
    ],
    "donts": [
      "**Don't** substitute obsolete palette values for the restored source tokens.",
      "**Don't** treat decorative illustration typography as the general heading family.",
      "**Don't** remove source references or obscure incomplete coverage to simplify a result."
    ]
  }
